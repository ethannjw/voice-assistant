#!/usr/bin/env node
import readline from "node:readline";
import { closeSync } from "node:fs";
import { applyEdit, record, validateWorkspace, waitForGate } from "../protocol.mjs";

if (process.argv.includes("--version")) {
  console.log("codex-cli e2e");
  process.exit(0);
}
if (process.argv[2] !== "app-server" || !process.argv.includes("stdio://")) process.exit(2);
const lines = readline.createInterface({ input: process.stdin });
const threads = new Map();
const turns = new Map();
const requests = new Map();
let initialized = false;
let threadCounter = 0;
let turnCounter = 0;
let requestCounter = 90000;
const write = (message) => process.stdout.write(`${JSON.stringify(message)}\n`);
const respond = (id, result) => write({ id, result });
record({ event: "process-start", pid: process.pid });

function finish(turn, suffix = "", status = "completed") {
  if (!turns.has(turn.id)) return;
  if (status === "completed") {
    write({ method: "item/agentMessage/delta", params: {
      threadId: turn.threadId, turnId: turn.id, delta: `Fake Codex completed: ${turn.text}${suffix}`
    } });
  }
  write({ method: "turn/completed", params: {
    threadId: turn.threadId, turn: { id: turn.id, status, error: status === "failed" ? { message: "E2E turn failed" } : null }
  } });
  turns.delete(turn.id);
  for (const [requestId, pending] of requests) {
    if (pending.turn === turn) requests.delete(requestId);
  }
}

lines.on("line", async (line) => {
  if (!line.trim()) return;
  const message = JSON.parse(line);
  record(message);
  try {
    if (!message.method) {
      const pending = requests.get(message.id);
      if (!pending) throw new Error("Unknown server request response");
      requests.delete(message.id);
      if (pending.question) {
        const answer = message.result?.answers?.approach?.answers?.[0];
        if (!answer) throw new Error("Question requires a user answer");
        finish(pending.turn, ` [answer=${answer}]`);
      } else {
        const decision = message.result?.decision;
        if (!["accept", "acceptForSession", "decline", "cancel"].includes(decision)) throw new Error("Invalid approval decision");
        if (decision.startsWith("accept") && pending.turn.text.includes("e2e:edit")) {
          applyEdit(threads.get(pending.turn.threadId).cwd, "codex");
        }
        finish(pending.turn, ` [permission=${decision}]`);
      }
      return;
    }
    if (message.method === "initialize") {
      if (!message.params?.clientInfo?.name) throw new Error("clientInfo required");
      initialized = true;
      respond(message.id, { userAgent: "codex-e2e" });
      return;
    }
    if (!initialized) throw new Error("Initialize first");
    if (message.method === "initialized") return;
    if (message.method === "thread/start") {
      validateWorkspace(message.params?.cwd);
      if (!["on-request", "never"].includes(message.params.approvalPolicy)) throw new Error("Approval policy required");
      if (!["workspace-write", "read-only"].includes(message.params.sandbox)) throw new Error("Sandbox required");
      const threadId = `e2e-thread-${++threadCounter}`;
      threads.set(threadId, message.params);
      await waitForGate();
      respond(message.id, { thread: { id: threadId } });
      return;
    }
    if (message.method === "turn/start") {
      if (!threads.has(message.params?.threadId)) throw new Error("Unknown thread");
      if ([...turns.values()].some((turn) => turn.threadId === message.params.threadId)) throw new Error("Concurrent turn on thread");
      const text = message.params.input?.[0]?.text;
      if (typeof text !== "string") throw new Error("Text input required");
      const turn = { id: `e2e-turn-${++turnCounter}`, threadId: message.params.threadId, text };
      turns.set(turn.id, turn);
      respond(message.id, { turn: { id: turn.id } });
      if (text.includes("e2e:close-stdin")) {
        process.stdin.destroy();
        try { closeSync(0); }
        catch (error) { if (error.code !== "EBADF") throw error; }
        record({ event: "stdin-closed", pid: process.pid });
        setInterval(() => {}, 1000);
        return;
      }
      if (text.includes("e2e:crash")) process.exit(7);
      if (text.includes("wait for cancellation")) return;
      if (text.includes("e2e:question")) {
        const requestId = ++requestCounter;
        requests.set(requestId, { turn, question: true });
        write({ id: requestId, method: "item/tool/requestUserInput", params: {
          threadId: turn.threadId, turnId: turn.id, itemId: `question-${turn.id}`,
          questions: [{ id: "approach", header: "Approach", question: "Which implementation should I use?", isOther: true, isSecret: false,
            options: [{ label: "Minimal", description: "Small targeted change" }, { label: "Refactor", description: "Larger change" }] }]
        } });
        return;
      }
      if (text.includes("needs approval") || text.includes("e2e:edit")) {
        const requestId = ++requestCounter;
        requests.set(requestId, { turn });
        write({ id: requestId, method: "item/commandExecution/requestApproval", params: {
          threadId: turn.threadId, turnId: turn.id, itemId: `item-${turn.id}`,
          command: "npm test", cwd: threads.get(turn.threadId).cwd,
          availableDecisions: ["accept", "acceptForSession", "decline"]
        } });
        return;
      }
      setImmediate(() => finish(turn, "", text.includes("e2e:fail") ? "failed" : "completed"));
      return;
    }
    if (message.method === "turn/interrupt") {
      const turn = turns.get(message.params?.turnId);
      if (!turn || turn.threadId !== message.params.threadId) throw new Error("Unknown turn");
      respond(message.id, {});
      finish(turn, "", "interrupted");
      return;
    }
    throw new Error(`Unsupported method: ${message.method}`);
  } catch (error) {
    if (message.method && message.id !== undefined) write({ id: message.id, error: { code: -32602, message: error.message } });
    else { console.error(error.message); process.exit(3); }
  }
});
