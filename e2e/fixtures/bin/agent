#!/usr/bin/env node

import readline from "node:readline";
import { writeFileSync } from "node:fs";
import { applyEdit, record, validateWorkspace, waitForGate } from "../protocol.mjs";

if (process.argv.includes("--version")) {
  console.log("cursor-agent e2e");
  process.exit(0);
}
if (process.argv[2] !== "acp") process.exit(2);

const lines = readline.createInterface({ input: process.stdin });
const sessions = new Map();
const pendingPrompts = new Map();
const pendingPermissions = new Map();
const cancelledPermissions = new Set();
let sessionCounter = 0;
let permissionCounter = 90000;
let initialized = false;
const modelOptions = [
  { value: "cursor-default", name: "Cursor Default" },
  { value: "cursor-e2e-model", name: "Cursor E2E Model" },
  { value: "composer-2.5[fast=true]", name: "Composer 2.5" },
  { value: "ambiguous-model[fast=true]", name: "Fast variant" },
  { value: "ambiguous-model[fast=false]", name: "Standard variant" }
];

function write(message) {
  process.stdout.write(`${JSON.stringify({ jsonrpc: "2.0", ...message })}\n`);
}

function respond(id, result) {
  write({ id, result });
}

function sendAgentText(sessionId, text) {
  write({
    method: "session/update",
    params: {
      sessionId,
      update: {
        sessionUpdate: "agent_message_chunk",
        content: { type: "text", text }
      }
    }
  });
}

function promptText(params) {
  return Array.isArray(params?.prompt)
    ? params.prompt
        .filter((block) => block?.type === "text")
        .map((block) => block.text)
        .join("\n")
    : "";
}

function finishPrompt(request, suffix = "") {
  const session = sessions.get(request.params.sessionId);
  const text = promptText(request.params);
  sendAgentText(
    request.params.sessionId,
    `Fake Cursor (${session?.model ?? "cursor-default"}, ${request.params.sessionId}) completed: ${text}${suffix}`
  );
  respond(request.id, { stopReason: "end_turn" });
  pendingPrompts.delete(request.params.sessionId);
}

lines.on("line", async (line) => {
  if (!line.trim()) return;
  const message = JSON.parse(line);
  record(message);

  if (message.method === "initialize") {
    if (message.params?.protocolVersion !== 1) {
      write({ id: message.id, error: { code: -32602, message: "Unsupported protocol" } });
      return;
    }
    initialized = true;
    respond(message.id, {
      protocolVersion: 1,
      agentCapabilities: {
        loadSession: false,
        promptCapabilities: { image: false, audio: false, embeddedContext: false }
      },
      authMethods: []
    });
    return;
  }

  if (message.method === "session/new") {
    if (!initialized) throw new Error("Initialize first");
    validateWorkspace(message.params?.cwd);
    sessionCounter += 1;
    const sessionId = `cursor-e2e-session-${sessionCounter}`;
    sessions.set(sessionId, { model: "cursor-default", cwd: message.params.cwd });
    if (process.env.E2E_CURSOR_SESSION_MARKER) {
      writeFileSync(process.env.E2E_CURSOR_SESSION_MARKER, sessionId, "utf8");
    }
    const response = {
      sessionId,
      modes: {
        currentModeId: "agent",
        availableModes: [{ id: "agent", name: "Agent", description: "Full coding mode" }]
      },
      configOptions: [
        {
          type: "select",
          id: "model",
          name: "Model",
          description: "Cursor model",
          category: "model",
          currentValue: "cursor-default",
          options: process.env.E2E_CURSOR_GROUP_MODELS === "1"
            ? [{ group: "models", name: "Models", options: modelOptions }]
            : modelOptions
        }
      ]
    };
    if (process.env.E2E_CURSOR_BLOCK_SESSION === "1") return;
    await waitForGate();
    respond(message.id, response);
    return;
  }

  if (message.method === "session/set_config_option") {
    const session = sessions.get(message.params.sessionId);
    if (!session || message.params.configId !== "model" || !modelOptions.some((option) => option.value === message.params.value)) {
      write({ id: message.id, error: { code: -32602, message: "Unsupported model configuration" } });
      return;
    }
    session.model = message.params.value;
    respond(message.id, { configOptions: [] });
    return;
  }

  if (message.method === "session/prompt") {
    if (!sessions.has(message.params?.sessionId) || pendingPrompts.has(message.params.sessionId)) {
      write({ id: message.id, error: { code: -32602, message: "Unknown session or concurrent prompt" } });
      return;
    }
    pendingPrompts.set(message.params.sessionId, message);
    if (process.env.E2E_CURSOR_PROMPT_MARKER) {
      writeFileSync(process.env.E2E_CURSOR_PROMPT_MARKER, message.params.sessionId, "utf8");
    }
    const text = promptText(message.params);
    if (text.includes("e2e:crash")) process.exit(7);
    if (text.includes("e2e:fail")) {
      pendingPrompts.delete(message.params.sessionId);
      write({ id: message.id, error: { code: -32000, message: "E2E turn failed" } });
      return;
    }

    if (text.includes("wait for cancellation")) {
      return;
    }

    if (text.includes("needs approval") || text.includes("e2e:edit")) {
      const permissionId = ++permissionCounter;
      pendingPermissions.set(permissionId, message);
      write({
        id: permissionId,
        method: "session/request_permission",
        params: {
          sessionId: message.params.sessionId,
          toolCall: {
            toolCallId: "cursor-tool-call",
            title: "Run npm test",
            kind: "execute",
            status: "pending",
            rawInput: { command: "npm test" }
          },
          options: [
            ...text.includes("persistent-only") ? [] : [{ optionId: "allow-once", name: "Allow once", kind: "allow_once" }],
            { optionId: "allow-session", name: "Allow for session", kind: "allow_always" },
            { optionId: "reject-once", name: "Reject", kind: "reject_once" }
          ]
        }
      });
      return;
    }

    finishPrompt(message);
    return;
  }

  if (message.method === "session/cancel") {
    for (const [permissionId, pending] of pendingPermissions) {
      if (pending.params.sessionId === message.params.sessionId) {
        write({ method: "$/cancel_request", params: { requestId: permissionId } });
        pendingPermissions.delete(permissionId);
        cancelledPermissions.add(permissionId);
      }
    }
    const request = pendingPrompts.get(message.params.sessionId);
    if (request) {
      respond(request.id, { stopReason: "cancelled" });
      pendingPrompts.delete(message.params.sessionId);
    }
    return;
  }

  if (message.id !== undefined && pendingPermissions.has(message.id)) {
    const request = pendingPermissions.get(message.id);
    pendingPermissions.delete(message.id);
    const optionId = message.result?.outcome?.optionId ?? "cancelled";
    if (optionId.startsWith("allow") && promptText(request.params).includes("e2e:edit")) {
      applyEdit(sessions.get(request.params.sessionId).cwd, "cursor");
    }
    finishPrompt(request, ` [permission=${optionId}]`);
    return;
  }
  if (message.method === "$/cancel_request") return;
  if (cancelledPermissions.delete(message.id)) return;
  if (message.id !== undefined) write({ id: message.id, error: { code: -32601, message: `Unsupported method: ${message.method}` } });
});
