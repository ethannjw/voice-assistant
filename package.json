{
  "name": "voice-pair-programmer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "teams": "tsx src/server/teams.ts",
    "meeting:check": "tsx src/server/meeting/check.ts",
    "meeting:build": "python3 integrations/attendee/build.py",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run check",
    "check": "npm run typecheck && npm run test:e2e:typecheck && npm run build && npm run test:e2e",
    "test:cursor": "npm run test:e2e -- e2e/cursor-browser.spec.ts e2e/coding-agent.spec.ts e2e/provider-contract.spec.ts --grep '[Cc]ursor|browser|Realtime|persistent-only'",
    "test:attention:live": "tsx e2e/live/attention-eval.ts",
    "test:search:live": "tsx e2e/live/attention-eval.ts --search-policy",
    "test:e2e": "npm run test:e2e:prepare && playwright test",
    "test:e2e:debug": "npm run test:e2e:prepare && playwright test --debug",
    "test:e2e:firecrawl": "tsx e2e/support/firecrawl-stub.ts",
    "test:e2e:headed": "npm run test:e2e:prepare && playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:prepare": "tsx e2e/support/prepare.ts",
    "test:e2e:serve": "tsx src/server/index.ts",
    "test:e2e:typecheck": "tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e:ui": "npm run test:e2e:prepare && playwright test --ui"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1"
  }
}
