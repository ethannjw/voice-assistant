# ========================================
# Voice Pair Programmer — environment vars
# ========================================
# Copy this file to .env and fill in OPENAI_API_KEY.
# All other settings have working defaults.

# --- Required ---------------------------------------------------------------

# OpenAI API key with access to gpt-realtime-2 (used for the voice session).
# The coding agent authenticates independently through Cursor or Codex CLI.
OPENAI_API_KEY=sk-proj-...

# Base URL for Realtime API requests. Both an origin and a URL ending in /v1
# are accepted. Defaults to https://api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com

# --- Voice (OpenAI Realtime API) -------------------------------------------

# Realtime model used for low-latency voice conversation.
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Realtime voice preset (e.g. marin, cedar, alloy).
OPENAI_REALTIME_VOICE=marin

# --- Web search (self-hosted Firecrawl) ------------------------------------

# The web_search tool calls POST /v2/search on a self-hosted Firecrawl instance
# you run with Docker Compose. Start it before using web_search:
#   cd /path/to/firecrawl && docker compose up -d
# First-time install: see README "Setting Up Self-Hosted Firecrawl with Docker".
# An origin or a URL already ending in /v2 both work.
FIRECRAWL_BASE_URL=http://localhost:3002

# Optional for authenticated Firecrawl deployments; sent as Authorization: Bearer.
# The local stack with USE_DB_AUTHENTICATION=false does not require a key.
# FIRECRAWL_API_KEY=

# --- Coding agent ----------------------------------------------------------

# Coding backend. Cursor is the default. Set codex to use Codex App Server.
CODING_AGENT=cursor

# Cursor Agent CLI command used as `<command> acp`.
# Authenticate first with `agent login`; verify with `agent status`.
# CURSOR_AGENT_COMMAND=agent

# Optional Cursor model. Use `agent models` to list models available to your account.
# When unset, Cursor uses its configured default model.
# CURSOR_MODEL=

# --- Codex settings (only when CODING_AGENT=codex) -------------------------

# Codex model_provider defined in ~/.codex/config.toml, applied as
# `codex app-server -c model_provider=<name> --listen stdio://`.
# This is how you point Codex at a non-default provider (e.g. a local gateway),
# since thread/start can override the model but not the provider.
# NOTE: `--profile` does NOT work here — codex-cli only accepts it on runtime
# commands (codex, codex exec, codex mcp, ...), not on `app-server`.
# CODEX_MODEL_PROVIDER=custom

# Codex coding model. Default gpt-5.4 is what has been verified end-to-end.
# Note: gpt-5.5 is not usable through codex app-server right now even on the
# latest CLI (works in `codex` direct mode, but thread/start rejects it).
# See README "gpt-5.5 requires a newer version of Codex" for details.
# When CODEX_MODEL_PROVIDER is set, use a model that provider serves.
CODEX_MODEL=gpt-5.4

# If the selected model_provider declares `env_key = "..."` in config.toml, that
# variable must exist in this process's env — codex app-server is spawned with it
# inherited. Example for a local bridge provider:
# AMP_BRIDGE_API_KEY=amp-bridge-local

# --- Workspace / projects --------------------------------------------------

# Default workspace path. Used to clean up legacy saved data.
# WORKSPACE_ROOT=/absolute/path/to/a/local/repo

# Empty scratch directory used when no project is selected.
# Defaults to an OS temp folder under voice-pair-programmer/no-project.
# NO_PROJECT_WORKSPACE=

# Where the registered project list is persisted (server-side).
PROJECTS_FILE=.voice-pair-programmer/projects.json

# Directories to scan from the "Find repositories" UI button.
# Use the platform path delimiter (":" on macOS/Linux, ";" on Windows).
# Defaults to this repository's parent directory.
# PROJECT_SEARCH_ROOTS=/Users/me/code:/Users/me/work

# Command run by the run_tests tool / TESTS button.
# TEST_COMMAND=npm test

# --- Server ----------------------------------------------------------------

PORT=8787
