# ========================================
# Voice Pair Programmer — environment vars
# ========================================
# Copy this file to .env and fill in OPENAI_API_KEY.
# All other settings have working defaults.

# --- Required ---------------------------------------------------------------

# OpenAI API key with access to gpt-realtime-2 (used for the voice session).
# Codex App Server uses Codex CLI's login instead — see README.
OPENAI_API_KEY=sk-proj-...

# --- Voice (OpenAI Realtime API) -------------------------------------------

# Realtime model used for low-latency voice conversation.
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Realtime voice preset (e.g. marin, cedar, alloy).
OPENAI_REALTIME_VOICE=marin

# --- Coding (Codex App Server) ---------------------------------------------

# Codex coding model. Default gpt-5.4 is what we've verified end-to-end.
# Note: gpt-5.5 is not usable through codex app-server right now even on the
# latest CLI (works in `codex` direct mode, but thread/start rejects it).
# See README "gpt-5.5 requires a newer version of Codex" for details.
CODEX_MODEL=gpt-5.4

# --- Workspace / projects --------------------------------------------------

# Default workspace path. Used to clean up legacy saved data.
# WORKSPACE_ROOT=/absolute/path/to/a/local/repo

# Empty scratch directory used when no project is selected.
# Defaults to an OS temp folder under voice-pair-programmer/no-project.
# NO_PROJECT_WORKSPACE=

# Where the registered project list is persisted (server-side).
PROJECTS_FILE=.voice-pair-programmer/projects.json

# Directories to scan from the "Find repositories" UI button.
# Use the platform path delimiter (":" on macOS/Linux, ";" on Windows).
# Defaults to this repository's parent directory.
# PROJECT_SEARCH_ROOTS=/Users/me/code:/Users/me/work

# Command run by the run_tests tool / TESTS button.
# TEST_COMMAND=npm test

# --- Server ----------------------------------------------------------------

PORT=8787
